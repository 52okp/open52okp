{
  "name": "52okp/account-center",
  "description": "52okp unified account center for Baota PHP and MySQL 5.7",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.8",
    "league/oauth2-server": "^9.2",
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^7.0",
    "spomky-labs/otphp": "^11.3",
    "ext-sodium": "*",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "Okp\\": "app/"
    },
    "classmap": [
      "app/OAuth/Entities.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "scripts": {
    "test": "php tests/run.php"
  }
}
